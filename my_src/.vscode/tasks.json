{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build current file (basil)",
      "type": "shell",
      "command": "${config:picbasic.compilerPath}",
      "args": ["${file}"],
      "options": { "cwd": "${fileDirname}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$basil",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Check current file (basil)",
      "type": "shell",
      "command": "${config:picbasic.compilerPath}",
      "args": ["--check", "${file}"],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "problemMatcher": "$basil"
    }
  ]
}

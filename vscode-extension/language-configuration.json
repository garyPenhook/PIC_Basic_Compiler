{
  "comments": {
    "lineComment": "'",
    "blockComment": [
      "(*",
      "*)"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ],
    [
      "(*",
      "*)"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "(*",
      "close": " *)",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "{",
      "}"
    ]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|\\$[0-9A-Fa-f]+|%[01]+|\\d+(\\.\\d+)?",
  "folding": {
    "markers": {
      "start": "^\\s*'\\s*#?region\\b",
      "end": "^\\s*'\\s*#?endregion\\b"
    }
  }
}